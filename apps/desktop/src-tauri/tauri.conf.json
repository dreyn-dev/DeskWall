{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskWall",
  "version": "0.1.0",
  "identifier": "app.deskwall.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "wallpaper",
        "title": "DeskWall Wallpaper",
        "url": "wallpaper.html",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "width": 1280,
        "height": 720
      },
      {
        "label": "settings",
        "title": "DeskWall",
        "url": "index.html",
        "visible": false,
        "center": true,
        "decorations": false,
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "dock",
        "title": "DeskWall",
        "url": "index.html?mode=dock",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNTIxRjk3MzNDQTNFMDEKUldRQlBzb3pseDlTbm43aThTbFVacSt3UE9XNHhsWm1Velg2ZVVmN3dIN01ucFJ4ZUNkWU5pa0MK",
      "endpoints": [
        "https://github.com/dreyn-dev/DeskWall/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DeskWall",
    "category": "Utility",
    "shortDescription": "A living wallpaper that grows around your desktop icons",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
